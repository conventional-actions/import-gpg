{
  "name": "import-gpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action to easily import a GPG key",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --sourcemap",
    "lint": "eslint src/**/*.ts __tests__/**/*.ts",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "format-check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage --coverageDirectory=coverage",
    "all": "npm run typecheck && npm run format && npm run lint && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conventional-actions/import-gpg.git"
  },
  "keywords": [
    "actions",
    "gpg",
    "signing",
    "git"
  ],
  "author": "CrazyMax",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "addressparser": "^1.0.1",
    "openpgp": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.56.0",
    "eslint-plugin-github": "^5.1.8",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.0"
  }
}
